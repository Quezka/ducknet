[Unit]
Description=DuckNet DNS (dns.quezka.uk)
After=network.target

[Service]
User=ducknet
WorkingDirectory=/opt/ducknet
EnvironmentFile=/etc/ducknet/ducknet.env
ExecStart=/usr/bin/python3 -m ducknet dns --registry /var/lib/ducknet/ducks.json --relay-ip ${DUCKNET_RELAY_IP}
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
Restart=always

[Install]
WantedBy=multi-user.target
